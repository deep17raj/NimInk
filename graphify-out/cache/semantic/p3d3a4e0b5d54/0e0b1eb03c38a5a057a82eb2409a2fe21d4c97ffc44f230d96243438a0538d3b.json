{"nodes": [{"id": "decisions_hono_over_express", "label": "D1: Hono over Express", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 3-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lighter, faster, better TypeScript support, built-in middleware. Deploys easily as a Node.js service."}, {"id": "decisions_better_sqlite3_no_orm", "label": "D2: better-sqlite3 Directly (No ORM)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 7-9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simpler, fewer dependencies, full control over queries. Drizzle adds complexity not needed for this scope. Migrations are plain SQL files."}, {"id": "decisions_jwt_sessions", "label": "D3: JWT for Sessions", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 11-13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simple, no session table needed. Demo mode generates JWTs the same way for consistency. Short expiry (24h) with refresh on activity."}, {"id": "decisions_demo_ledger_server_side", "label": "D4: Demo Ledger is Server-Side", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 15-17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-side verification must work identically in demo and real mode. A client-side demo ledger would bypass the verification pipeline."}, {"id": "decisions_no_escrow", "label": "D5: No Escrow for Requests", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 19-21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec requirement. Avoids custodial complexity and legal risk. Trade-off: an Awarded-unpaid state is possible; surfaced publicly as reputation pressure."}, {"id": "decisions_read_validation_server_driven", "label": "D6: Read Validation \u2014 Server-Driven, Probabilistic", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 23-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any client-side validation can be spoofed. Multiple weak signals (timing, quiz, device, IP) layered for reasonable confidence. Perfect Sybil resistance is out of scope."}, {"id": "decisions_luna_everywhere", "label": "D7: Luna Everywhere, NIM Only in Display", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 27-29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids floating-point errors. 1 NIM = 100,000 Luna. Conversion happens in shared helpers and Vue filters."}, {"id": "decisions_app_name_config", "label": "D8: App Name in One Config", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 31-33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Easy to rename. APP_NAME constant in packages/shared/src/config.ts. Used in UI text, page titles, and API responses."}, {"id": "decisions_tailwind_css", "label": "D9: Tailwind CSS for Styling", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 35-37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rapid mobile-first development. Utility classes keep component files self-contained. Custom theme with gold, blue, navy palette."}, {"id": "decisions_markdown_it_dompurify", "label": "D10: markdown-it + DOMPurify", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 39-41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec requirement. Prevents XSS while allowing rich markdown content. html option set to false."}, {"id": "decisions_monorepo_npm_workspaces", "label": "D11: Monorepo with npm Workspaces", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 43-45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero extra tooling. packages/shared referenced by both apps/web and apps/api via workspace protocol."}, {"id": "decisions_single_deploy_target", "label": "D12: Single Deploy Target", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 47-49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simplifies deployment. One Dockerfile, one process, one HTTPS origin. API routes under /api/*, SPA for everything else."}, {"id": "decisions_spanish_second_language", "label": "D13: Spanish as Second Language", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 51-53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large Nimiq community in Latin America. Demonstrates the i18n scaffold works."}, {"id": "decisions_crypto_uuid_fallback", "label": "D14: crypto.getRandomValues Fallback for UUIDs", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 55-57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nimiq Pay WebView over HTTP (local dev) is not a secure context; crypto.randomUUID() may be unavailable."}, {"id": "decisions_ed25519_signature_verification", "label": "D15: Real-Mode Signature Verification", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 59-61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDK sign() returns hex publicKey and signature. Nimiq uses Ed25519 for basic accounts. Exact verification library/method needs confirmation."}, {"id": "decisions_validator_list", "label": "D16: Validator List", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": "lines 63-65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mock validator list in demo mode. Real mode: fetch from public Nimiq staking API (endpoint TBD). No public validators API endpoint found in mini-app docs."}], "edges": [{"source": "decisions_hono_over_express", "target": "decisions_single_deploy_target", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "DECISIONS.md", "source_location": null, "weight": 1.0}, {"source": "decisions_better_sqlite3_no_orm", "target": "decisions_demo_ledger_server_side", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "DECISIONS.md", "source_location": null, "weight": 1.0}, {"source": "decisions_jwt_sessions", "target": "plan_auth_flow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "source_location": "lines 11-13", "weight": 1.0}, {"source": "decisions_demo_ledger_server_side", "target": "readme_demo_mode", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "source_location": "lines 15-17", "weight": 1.0}, {"source": "decisions_no_escrow", "target": "plan_phase_3_requests", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "source_location": "lines 19-21", "weight": 1.0}, {"source": "decisions_read_validation_server_driven", "target": "plan_read_validation_scoring", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "source_location": "lines 23-25", "weight": 1.0}, {"source": "decisions_read_validation_server_driven", "target": "security_fake_reads_sybil", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "so