# Wallet mode: "demo" or "nimiq"
VITE_WALLET_MODE=nimiq

# API URL (leave blank for same-origin requests through the Vite dev proxy)
VITE_API_URL=

# JWT secret for session tokens (generate a random 64-char hex string)
JWT_SECRET=change-me-to-a-random-secret

# Shared database (MongoDB Atlas or self-hosted MongoDB)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=nimink
APP_ORIGIN=https://your-mini-app.example

# Comma-separated Nimiq addresses allowed to access the admin API
ADMIN_ADDRESSES=

# Server port
PORT=3001

# Nimiq RPC endpoint (must match the network selected in Nimiq Pay)
# Public endpoint for local development/mainnet testing; use your own RPC in production.
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
# Testnet alternative: https://rpc.testnet.nimiqwatch.com/
# NIMIQ_RPC_USERNAME=
# NIMIQ_RPC_PASSWORD=

# Weekly read-reward pool size in Luna (200 NIM = 20_000_000 Luna)
POOL_SIZE_LUNA=20000000

# Pool sponsor name (shown in UI)
POOL_SPONSOR=Demo Labs
